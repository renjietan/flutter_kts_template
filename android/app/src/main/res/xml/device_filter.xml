<?xml version="1.0" encoding="utf-8"?>
<!--
    USB 设备过滤器：当此处列出的设备插入时，系统会通过
    AndroidManifest.xml 中的 USB_DEVICE_ATTACHED intent-filter 拉起应用。
    vendor-id / product-id 均为十进制。如需支持更多设备，按需追加 <usb-device> 节点。
-->
<resources>
    <!-- 0x0403 / 0x6001: FTDI FT232R UART -->
    <usb-device vendor-id="1027" product-id="24577" />

    <!-- 0x0403 / 0x6015: FTDI FT231X -->
    <usb-device vendor-id="1027" product-id="24597" />

    <!-- 0x2341 / Arduino -->
    <usb-device vendor-id="9025" />

    <!-- 0x16C0 / 0x0483: Teensyduino -->
    <usb-device vendor-id="5824" product-id="1155" />

    <!-- 0x10C4 / 0xEA60: CP210x UART Bridge -->
    <usb-device vendor-id="4292" product-id="60000" />

    <!-- 0x067B / 0x2303: Prolific PL2303 -->
    <usb-device vendor-id="1659" product-id="8963" />

    <!-- 0x1366 / 0x0105: Segger JLink -->
    <usb-device vendor-id="4966" product-id="261" />

    <!-- 0x1A86 / 0x7523: CH340 -->
    <usb-device vendor-id="6790" product-id="29987" />

    <!-- 0x1D6B / 0x0104: 公司自研注钥枪（Vendor Specific Bulk） -->
    <usb-device vendor-id="7531" product-id="260" />
</resources>
